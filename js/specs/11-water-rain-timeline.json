{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": true,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "usermeta": {
    "gutter": [
      108,
      0
    ]
  },
  "spacing": 34,
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "independent",
      "color": "independent"
    }
  },
  "title": {
    "text": "Water use follows last year's rain",
    "subtitle": "Rainfall (top) and water used (bottom) each financial year. Hover over a year's rainfall to light up the water used the year after.",
    "subtitleLimit": 760
  },
  "data": {
    "url": "data/water_account_national.csv",
    "format": {
      "type": "csv",
      "parse": {
        "area_average_rainfall_mm": "number",
        "total_water_consumption_GL": "number"
      }
    }
  },
  "vconcat": [
    {
      "width": 900,
      "height": 150,
      "transform": [
        {
          "calculate": "indexof([\"2018-19\", \"2019-20\"], datum.year) >= 0 ? 'dry' : indexof([\"2022-23\"], datum.year) >= 0 ? 'wet' : 'rest'",
          "as": "emph"
        },
        {
          "calculate": "indexof([\"2014-15\", \"2015-16\", \"2016-17\", \"2017-18\", \"2018-19\", \"2019-20\", \"2020-21\", \"2021-22\", \"2022-23\", \"2023-24\"], datum.year)",
          "as": "link"
        },
        {
          "calculate": "replace(datum.year, '-', '–')",
          "as": "fy_full"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "title": null,
              "sort": [
                "2014-15",
                "2015-16",
                "2016-17",
                "2017-18",
                "2018-19",
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24"
              ],
              "scale": {
                "paddingInner": 0.3,
                "paddingOuter": 0.15
              },
              "axis": {
                "labels": false,
                "ticks": false,
                "domain": true
              }
            },
            "y": {
              "field": "area_average_rainfall_mm",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  760
                ],
                "nice": false
              },
              "axis": {
                "title": "Rainfall (mm)",
                "titleAngle": 0,
                "titleAlign": "left",
                "titleBaseline": "bottom",
                "titleX": -108,
                "titleY": -12,
                "titleFontWeight": 600,
                "titleColor": "#333e38",
                "grid": true,
                "values": [
                  0,
                  200,
                  400,
                  600
                ],
                "format": ",.0f"
              }
            },
            "color": {
              "field": "emph",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "dry",
                  "wet",
                  "rest"
                ],
                "range": [
                  "#9c6114",
                  "#0f3f39",
                  "#a0a9a3"
                ]
              }
            },
            "opacity": {
              "condition": {
                "param": "lag",
                "empty": true,
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "fy_full",
                "type": "nominal",
                "title": "Year"
              },
              {
                "field": "area_average_rainfall_mm",
                "type": "quantitative",
                "title": "Rainfall (mm)"
              },
              {
                "field": "total_water_consumption_GL",
                "type": "quantitative",
                "title": "Water used (gigalitres)",
                "format": ","
              }
            ]
          },
          "params": [
            {
              "name": "lag",
              "select": {
                "type": "point",
                "fields": [
                  "link"
                ],
                "on": "mouseover",
                "clear": "mouseout"
              }
            }
          ]
        },
        {
          "transform": [
            {
              "filter": "datum.emph !== 'rest'"
            }
          ],
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 15,
            "fontWeight": 700,
            "baseline": "bottom",
            "dy": -4
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "title": null,
              "sort": [
                "2014-15",
                "2015-16",
                "2016-17",
                "2017-18",
                "2018-19",
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24"
              ],
              "scale": {
                "paddingInner": 0.3,
                "paddingOuter": 0.15
              },
              "axis": {
                "labels": false,
                "ticks": false,
                "domain": true
              }
            },
            "y": {
              "field": "area_average_rainfall_mm",
              "type": "quantitative"
            },
            "text": {
              "field": "area_average_rainfall_mm",
              "type": "quantitative",
              "format": ",.0f"
            },
            "color": {
              "field": "emph",
              "type": "nominal",
              "legend": null,
              "scale": {
                "domain": [
                  "dry",
                  "wet"
                ],
                "range": [
                  "#84520f",
                  "#0f3f39"
                ]
              }
            }
          }
        },
        {
          "data": {
            "values": [
              {
                "year": "2019-20",
                "v": 347,
                "t": "on record"
              }
            ]
          },
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 15,
            "fontWeight": 600,
            "fill": "#333e38",
            "baseline": "bottom",
            "dy": -24
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "ordinal",
              "sort": [
                "2014-15",
