            }
          }
        }
      ],
      "resolve": {
        "scale": {
          "color": "independent"
        }
      }
    },
    {
      "width": 900,
      "height": 170,
      "transform": [
        {
          "calculate": "indexof([\"2019-20\"], datum.year) >= 0 ? 'dry' : indexof([\"2023-24\"], datum.year) >= 0 ? 'wet' : 'rest'",
          "as": "emph"
        },
        {
          "calculate": "indexof([\"2014-15\", \"2015-16\", \"2016-17\", \"2017-18\", \"2018-19\", \"2019-20\", \"2020-21\", \"2021-22\", \"2022-23\", \"2023-24\"], datum.year) - 1",
          "as": "link"
        },
