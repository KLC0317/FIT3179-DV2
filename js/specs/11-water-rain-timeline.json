                "2016-17",
                "2017-18",
                "2018-19",
                "2019-20",
                "2020-21",
                "2021-22",
                "2022-23",
                "2023-24"
              ]
            },
            "y": {
              "field": "v",
              "type": "quantitative"
            },
            "text": {
              "field": "t",
              "type": "nominal"
            }
          }
        },
        {
