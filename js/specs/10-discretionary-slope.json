{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 228,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      0
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Discretionary food is losing ground, slowly",
    "subtitle": "Share of daily energy from foods such as confectionery, soft drink, pastries and alcohol. People aged 2 and over.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 26,
    "bottom": 5
  },
  "data": {
    "url": "data/food_consumption_indicators.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.indicator === 'Energy from discretionary foods'"
    },
    {
      "calculate": "replace(datum.year, '-', '–')",
      "as": "survey"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a0a9a3",
        "strokeWidth": 1.2,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "y": {
          "datum": 33.333333333333336,
          "type": "quantitative",
          "scale": {
            "domain": [
              28,
              38
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 15,
        "fontWeight": 600,
        "fill": "#57625b",
        "align": "left",
        "baseline": "top",
        "x": 4,
        "dy": 4
      },
      "encoding": {
        "y": {
          "datum": 33.333333333333336,
          "type": "quantitative",
          "scale": {
            "domain": [
              28,
              38
            ]
          }
        },
        "text": {
          "value": "one third of all energy"
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "color": "#9c6114",
        "point": {
          "filled": true,
          "size": 140,
          "color": "#9c6114"
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.5
          },
          "axis": {
            "labelFontSize": 16,
            "labelFontWeight": 700,
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#161f1b",
            "labelExpr": "replace(datum.label, '-', '–')"
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "domain": [
              28,
              38
            ]
          },
          "axis": {
            "title": "% of daily energy",
            "titleAngle": 0,
            "titleAlign": "left",
            "titleBaseline": "bottom",
            "titleX": -108,
            "titleY": -12,
            "titleFontWeight": 600,
            "titleColor": "#333e38",
            "grid": true
          }
        },
        "tooltip": [
          {
            "field": "survey",
            "type": "nominal",
            "title": "Survey"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.value, '.1f') + '%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 18,
        "fontWeight": 700,
        "fill": "#84520f",
        "dy": -24,
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.5
          },
          "axis": {
            "labelFontSize": 16,
            "labelFontWeight": 700,
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#161f1b",
            "labelExpr": "replace(datum.label, '-', '–')"
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "down 4.1 percentage points in 11 years,"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#57625b",
        "x": {
          "expr": "width"
        },
        "y": 8,
        "align": "right"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "but still almost a third of all energy"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#57625b",
        "x": {
          "expr": "width"
        },
        "y": 30,
        "align": "right"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ]
}
