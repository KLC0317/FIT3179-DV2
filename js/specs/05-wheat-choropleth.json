{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 390,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#57625b",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#333e38",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#57625b",
      "symbolStrokeWidth": 0,
      "offset": 6,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Inter",
      "fontSize": 12
    },
    "title": {
      "font": "Noto Serif",
      "fontSize": 14,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 16
    }
  },
  "title": {
    "text": "How hard each state works its land for wheat",
    "subtitle": "Tonnes of wheat sold per square kilometre of state area, classed at 1, 3, 6 and 15.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 5,
    "top": 60,
    "bottom": 5,
    "right": 22
  },
  "params": [
    {
      "name": "season",
      "value": "2024_25",
      "bind": {
        "input": "radio",
        "options": [
          "2022_23",
          "2023_24",
          "2024_25"
        ],
        "labels": [
          "2022-23  ",
          "2023-24  ",
          "2024-25"
        ],
        "name": "Season  "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -133,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au-states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/wheat_state_density.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "kt_2022_23": "number",
                  "kt_2023_24": "number",
                  "kt_2024_25": "number",
                  "tpk_2022_23": "number",
                  "tpk_2023_24": "number",
                  "tpk_2024_25": "number",
                  "area_km2": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "area_km2",
              "kt_2022_23",
              "kt_2023_24",
              "kt_2024_25",
              "tpk_2022_23",
              "tpk_2023_24",
              "tpk_2024_25"
            ]
          }
        },
        {
          "calculate": "datum['tpk_' + season]",
          "as": "intensity"
        },
        {
          "calculate": "datum['kt_' + season]",
          "as": "kt"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fbfaf6",
        "strokeWidth": 1.1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.intensity === '' || !isValid(datum.intensity)",
            "value": "#eaece8"
          },
          "field": "intensity",
          "type": "quantitative",
          "title": "Wheat per km\u00b2 (t)",
          "scale": {
            "type": "threshold",
            "domain": [
              1,
              3,
              6,
              15
            ],
            "range": [
              "#ddeeea",
              "#8fc4ba",
              "#33887c",
              "#17554c",
              "#0b312c"
            ]
          },
          "legend": {
            "direction": "horizontal",
            "orient": "top",
            "titleLimit": 340,
            "symbolType": "square",
            "symbolSize": 160,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "intensity",
            "type": "quantitative",
            "title": "Wheat per km2 (tonnes)",
            "format": ".2f"
          },
          {
            "field": "kt",
            "type": "quantitative",
            "title": "Wheat sold (kt)",
            "format": ","
          },
          {
            "field": "area_km2",
            "type": "quantitative",
            "title": "State area (km2)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/wheat_state_density.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "kt_2022_23": "number",
                  "kt_2023_24": "number",
                  "kt_2024_25": "number",
                  "tpk_2022_23": "number",
                  "tpk_2023_24": "number",
                  "tpk_2024_25": "number",
                  "area_km2": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "area_km2",
              "kt_2022_23",
              "kt_2023_24",
              "kt_2024_25",
              "tpk_2022_23",
              "tpk_2023_24",
              "tpk_2024_25"
            ]
          }
        },
        {
          "calculate": "datum['tpk_' + season]",
          "as": "intensity"
        },
        {
          "calculate": "datum['kt_' + season]",
          "as": "kt"
        },
        {
          "calculate": "{'New South Wales':'NSW','Victoria':'VIC','Queensland':'QLD','South Australia':'SA','Western Australia':'WA','Tasmania':'TAS','Northern Territory':'NT','Australian Capital Territory':''}[datum.state]",
          "as": "abbr"
        },
        {
          "filter": "datum.abbr !== '' && datum.abbr !== 'TAS'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "fill": "#161f1b"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "abbr",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "isValid(datum.intensity) && datum.intensity >= 6",
            "value": "#ffffff"
          },
          "value": "#161f1b"
        }
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "filter": "datum.state === 'Northern Territory'"
        },
        {
          "calculate": "'no published figure'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "center",
        "dy": 17,
        "limit": 160
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
