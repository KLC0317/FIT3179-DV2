    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/wheat_state_density.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "kt_2022_23": "number",
                  "kt_2023_24": "number",
                  "kt_2024_25": "number",
                  "tpk_2022_23": "number",
                  "tpk_2023_24": "number",
                  "tpk_2024_25": "number",
                  "area_km2": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "area_km2",
              "kt_2022_23",
              "kt_2023_24",
              "kt_2024_25",
              "tpk_2022_23",
              "tpk_2023_24",
              "tpk_2024_25"
            ]
          }
        },
        {
          "calculate": "(datum['tpk_' + season] === '' || datum['tpk_' + season] == null) ? null : toNumber(datum['tpk_' + season])",
          "as": "intensity"
        },
        {
          "calculate": "(datum['kt_' + season] === '' || datum['kt_' + season] == null) ? null : toNumber(datum['kt_' + season])",
          "as": "kt"
        },
        {
          "calculate": "datum.state === 'Western Australia' ? datum.intensity : null",
          "as": "wa"
        },
        {
          "joinaggregate": [
            {
              "op": "max",
              "field": "wa",
              "as": "wa_rate"
            }
          ]
        },
        {
          "filter": "datum.state === 'Victoria'"
