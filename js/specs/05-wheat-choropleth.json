{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 380,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      0,
      0
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#4a554f",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a554f",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Victoria works its land hardest for wheat",
    "subtitle": "Tonnes of wheat per square kilometre of state area, classed at 1, 3, 6 and 15. Dots mark the state capitals.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 5,
    "bottom": 5
  },
  "view": {
    "fill": "#d6e3e9",
    "stroke": null
  },
  "params": [
    {
      "name": "season",
      "value": "2024_25",
      "bind": {
        "input": "radio",
        "options": [
          "2022_23",
          "2023_24",
          "2024_25"
        ],
        "labels": [
          "2022–23  ",
          "2023–24  ",
          "2024–25"
        ],
        "name": "Season  "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "rotate": [
      -133,
      0
    ],
    "parallels": [
      -18,
      -36
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au-states.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME + ': no figure published by the Australian Bureau of Statistics'",
          "as": "note"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#c3cac5",
        "stroke": "#fefdf9",
        "strokeWidth": 1.1
      },
      "encoding": {
        "tooltip": {
          "field": "note",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "url": "data/au-states.json",
        "format": {
          "type": "topojson",
          "feature": "austates"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/wheat_state_density.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "kt_2022_23": "number",
                  "kt_2023_24": "number",
                  "kt_2024_25": "number",
                  "tpk_2022_23": "number",
                  "tpk_2023_24": "number",
                  "tpk_2024_25": "number",
                  "area_km2": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "area_km2",
              "kt_2022_23",
              "kt_2023_24",
              "kt_2024_25",
              "tpk_2022_23",
              "tpk_2023_24",
              "tpk_2024_25"
            ]
          }
        },
        {
          "calculate": "(datum['tpk_' + season] === '' || datum['tpk_' + season] == null) ? null : toNumber(datum['tpk_' + season])",
          "as": "intensity"
        },
        {
          "calculate": "(datum['kt_' + season] === '' || datum['kt_' + season] == null) ? null : toNumber(datum['kt_' + season])",
          "as": "kt"
        },
        {
          "calculate": "toNumber(datum.area_km2)",
          "as": "area_km2"
        },
        {
          "calculate": "isValid(datum.intensity) ? format(datum.intensity, '.1f') + ' tonnes per square kilometre' : 'No figure published by the Australian Bureau of Statistics'",
          "as": "rate_text"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#fefdf9",
        "strokeWidth": 1.1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "!isValid(datum.intensity)",
            "value": "#c3cac5"
          },
          "field": "intensity",
          "type": "quantitative",
          "title": "Tonnes of wheat per square kilometre",
          "scale": {
            "type": "threshold",
            "domain": [
              1,
              3,
              6,
              15
            ],
            "range": [
              "#ddeeea",
              "#8fc4ba",
              "#3e9588",
              "#17554c",
              "#0b312c"
            ]
          },
          "legend": {
            "direction": "horizontal",
            "orient": "none",
            "legendX": 0,
            "legendY": -118,
            "titleLimit": 420,
            "symbolType": "square",
            "symbolSize": 190,
            "format": ".0f"
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "rate_text",
            "type": "nominal",
            "title": "Wheat per square kilometre"
          },
          {
            "field": "kt",
            "type": "quantitative",
            "title": "Wheat sold (thousand tonnes)",
            "format": ","
          },
          {
            "field": "area_km2",
            "type": "quantitative",
            "title": "State area (square kilometres)",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_centroids.csv"
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "data/wheat_state_density.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "kt_2022_23": "number",
                  "kt_2023_24": "number",
                  "kt_2024_25": "number",
                  "tpk_2022_23": "number",
                  "tpk_2023_24": "number",
                  "tpk_2024_25": "number",
                  "area_km2": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "area_km2",
              "kt_2022_23",
              "kt_2023_24",
              "kt_2024_25",
              "tpk_2022_23",
              "tpk_2023_24",
              "tpk_2024_25"
            ]
          }
        },
        {
          "calculate": "(datum['tpk_' + season] === '' || datum['tpk_' + season] == null) ? null : toNumber(datum['tpk_' + season])",
          "as": "intensity"
        },
        {
          "calculate": "(datum['kt_' + season] === '' || datum['kt_' + season] == null) ? null : toNumber(datum['kt_' + season])",
          "as": "kt"
        },
        {
          "filter": "!(indexof(['Tasmania','Australian Capital Territory'], datum.state) >= 0) && datum.state !== 'Victoria'"
        },
        {
          "calculate": "datum.longitude",
          "as": "lab_lon"
        },
        {
          "calculate": "datum.latitude",
          "as": "lab_lat"
        },
        {
          "calculate": "isValid(datum.intensity) ? format(datum.intensity, '.0f') : 'no figure'",
          "as": "t"
        },
        {
          "calculate": "{'New South Wales':'New South','Victoria':'Victoria','Queensland':'Queensland','South Australia':'South','Western Australia':'Western','Tasmania':'Tasmania','Northern Territory':'Northern','Australian Capital Territory':'Canberra'}[datum.state]",
          "as": "l1"
        },
        {
          "calculate": "{'New South Wales':'Wales','South Australia':'Australia','Western Australia':'Australia','Northern Territory':'Territory'}[datum.state] || ''",
          "as": "l2"
        },
        {
          "calculate": "datum.l2 ? [datum.l1, datum.l2] : [datum.l1]",
          "as": "name_lines"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lab_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lab_lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 15,
            "fontWeight": 700,
            "baseline": "bottom",
            "dy": -1,
            "lineHeight": 17
          },
          "encoding": {
            "text": {
              "field": "name_lines",
              "type": "nominal"
            },
            "color": {
              "condition": {
                "test": "isValid(datum.intensity) && datum.intensity >= 6",
                "value": "#ffffff"
              },
              "value": "#161f1b"
            }
          },
          "transform": [
            {
              "filter": "!datum.l2"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 15,
            "fontWeight": 700,
            "baseline": "bottom",
            "dy": -18,
            "lineHeight": 17
          },
          "encoding": {
            "text": {
              "field": "name_lines",
              "type": "nominal"
            },
            "color": {
              "condition": {
                "test": "isValid(datum.intensity) && datum.intensity >= 6",
                "value": "#ffffff"
              },
              "value": "#161f1b"
            }
          },
          "transform": [
            {
              "filter": "datum.l2"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 15,
            "fontWeight": 400,
            "baseline": "top",
            "dy": 3,
            "lineHeight": 17
          },
          "encoding": {
            "text": {
              "field": "t",
              "type": "nominal"
            },
            "color": {
              "condition": {
                "test": "isValid(datum.intensity) && datum.intensity >= 6",
                "value": "#ffffff"
              },
              "value": "#161f1b"
            }
          }
        }
      ]
    },
