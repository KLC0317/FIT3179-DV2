{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 325,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      10
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": true,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "A wheat crop can halve, then more than double",
    "subtitle": "Year-on-year change, 1962–2024. The box holds the middle half of years, the line is the typical year, dots are rare extremes.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 5
  },
  "data": {
    "url": "data/crop_production_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "production_kt": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "lag",
          "field": "production_kt",
          "as": "prev"
        }
      ],
      "groupby": [
        "crop"
      ],
      "sort": [
        {
          "field": "year",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.prev > 150"
    },
    {
      "calculate": "100 * (datum.production_kt - datum.prev) / datum.prev",
      "as": "pct"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a0a9a3",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 0,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "boxplot",
        "extent": 1.5,
        "size": 18,
        "outliers": false,
        "median": {
          "color": "#fefdf9",
          "strokeWidth": 2
        }
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative",
          "title": "Change on the previous year's harvest (%)",
          "scale": {
            "domain": [
              -80,
              180
            ],
            "nice": false
          },
          "axis": {
            "format": "+d",
            "grid": true,
            "values": [
              -80,
              -40,
              0,
              40,
              80,
              120,
              160
            ]
          }
        },
        "y": {
          "field": "crop",
          "type": "nominal",
          "title": null,
          "sort": [
            "Wheat",
            "Barley",
            "Canola",
            "Sugar cane",
            "Maize",
            "Dry peas"
          ],
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "color": {
          "field": "crop",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Wheat",
              "Barley",
              "Canola",
              "Sugar cane",
              "Maize",
              "Dry peas"
            ],
            "range": [
              "#0f3f39",
              "#a0a9a3",
              "#a0a9a3",
              "#57625b",
              "#a0a9a3",
              "#a0a9a3"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "q1",
              "field": "pct",
              "as": "q1"
            },
            {
              "op": "q3",
              "field": "pct",
              "as": "q3"
            }
          ],
          "groupby": [
            "crop"
          ]
        },
        {
          "filter": "datum.pct < datum.q1 - 1.5 * (datum.q3 - datum.q1) || datum.pct > datum.q3 + 1.5 * (datum.q3 - datum.q1)"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 40,
        "opacity": 0.85,
        "stroke": "#fefdf9",
        "strokeWidth": 0.8
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "y": {
          "field": "crop",
          "type": "nominal",
          "title": null,
          "sort": [
            "Wheat",
            "Barley",
            "Canola",
            "Sugar cane",
            "Maize",
            "Dry peas"
          ],
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "color": {
          "field": "crop",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Wheat",
              "Barley",
              "Canola",
              "Sugar cane",
              "Maize",
              "Dry peas"
            ],
            "range": [
              "#0f3f39",
              "#a0a9a3",
              "#a0a9a3",
              "#57625b",
              "#a0a9a3",
              "#a0a9a3"
            ]
          }
        },
        "tooltip": [
          {
            "field": "crop",
            "type": "nominal",
            "title": "Crop"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Change on previous year (%)",
            "format": "+.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "pct": 158,
            "crop": "Wheat",
            "t": "+158% in 2003"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "fill": "#0f3f39",
        "align": "right",
        "dx": 4,
        "dy": -15
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "y": {
          "field": "crop",
          "type": "nominal",
          "title": null,
          "sort": [
            "Wheat",
            "Barley",
            "Canola",
            "Sugar cane",
            "Maize",
            "Dry peas"
          ],
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "pct": 44,
            "crop": "Sugar cane",
            "t": "irrigated, so it barely moves"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 600,
        "fill": "#39423d",
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "y": {
          "field": "crop",
          "type": "nominal",
          "title": null,
          "sort": [
            "Wheat",
            "Barley",
            "Canola",
            "Sugar cane",
            "Maize",
            "Dry peas"
          ],
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ]
}
