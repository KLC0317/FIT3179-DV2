{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "usermeta": {
    "grid": [
      20,
      5
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "spacing": {
    "row": 22,
    "column": 84
  },
  "title": {
    "text": "Fewer than 5 in 100 Australians eat enough vegetables",
    "subtitle": "Each figure is one person in a hundred, 2023. A teal figure met the recommended daily serves for that food group; a grey one did not.",
    "subtitleLimit": 760
  },
  "data": {
    "url": "data/diet_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "met": "number",
        "col": "number",
        "row": "number",
        "met_pct": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.short + ': ' + format(datum.met_pct, '.0f') + ' in 100 (need ' + {\"Vegetables\": \"5\\u20136 a day\", \"Lean meat\": \"2\\u00bd\\u20133 a day\", \"Fruit\": \"2 a day\", \"Grains\": \"6 a day\"}[datum.short] + ')'",
      "as": "panel"
    },
    {
      "calculate": "datum.met == 1 ? 'Met the guideline' : 'Did not meet it'",
      "as": "status"
    },
    {
      "calculate": "datum.cell % 20",
      "as": "c"
    },
    {
      "calculate": "floor(datum.cell / 20)",
      "as": "r"
    },
    {
      "calculate": "'Adults need ' + {\"Vegetables\": \"5\\u20136\", \"Lean meat\": \"2\\u00bd\\u20133\", \"Fruit\": \"2\", \"Grains\": \"6\"}[datum.short] + ' serves'",
      "as": "need"
    }
  ],
  "columns": 2,
  "facet": {
    "field": "panel",
    "type": "nominal",
    "title": null,
    "sort": {
      "field": "met_pct",
      "op": "mean",
      "order": "ascending"
    },
    "header": {
      "labelFont": "Fraunces, Georgia, serif",
      "labelFontSize": 19,
      "labelFontWeight": 600,
      "labelColor": "#161f1b",
      "labelAnchor": "start",
      "labelPadding": 8,
      "title": null
    }
  },
  "spec": {
    "width": 500,
    "height": 125,
    "mark": {
      "type": "point",
      "shape": "M0,-0.96 A0.3,0.3 0 1,1 0,-0.36 A0.3,0.3 0 1,1 0,-0.96 Z M-0.48,-0.26 L0.48,-0.26 Q0.62,-0.26 0.62,-0.1 L0.62,0.4 L0.34,0.4 L0.34,1 L-0.34,1 L-0.34,0.4 L-0.62,0.4 L-0.62,-0.1 Q-0.62,-0.26 -0.48,-0.26 Z",
      "filled": true,
      "size": 300,
      "strokeWidth": 0,
      "opacity": 1
    },
    "encoding": {
      "x": {
        "field": "c",
        "type": "ordinal",
        "axis": null,
        "scale": {
          "type": "point",
          "padding": 0.5
        }
      },
      "y": {
        "field": "r",
        "type": "ordinal",
        "axis": null,
        "sort": "descending",
        "scale": {
          "type": "point",
          "padding": 0.5
        }
      },
      "color": {
        "field": "status",
        "type": "nominal",
        "legend": null,
        "scale": {
          "domain": [
            "Met the guideline",
            "Did not meet it"
          ],
          "range": [
            "#0f3f39",
            "#dee2dd"
          ]
        }
      },
      "tooltip": [
        {
          "field": "food_group",
          "type": "nominal",
          "title": "Food group"
        },
        {
          "field": "met_pct",
          "type": "quantitative",
          "title": "Met the guideline (%)",
          "format": ".1f"
        },
        {
          "field": "need",
          "type": "nominal",
          "title": "Guideline"
        }
      ]
    }
  }
}
