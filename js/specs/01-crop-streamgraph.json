{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 360,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      78
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Sixty-four years of harvests: wheat dominates, canola arrives",
    "subtitle": "Tonnes harvested each year, stacked around a centre line. Sugar cane is excluded. Click a band to isolate it; double-click to reset.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 46,
    "bottom": 5
  },
  "data": {
    "url": "data/crop_production_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "production_kt": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.crop !== 'Sugar cane'"
    },
    {
      "calculate": "indexof(['Wheat','Barley','Canola'], datum.crop) >= 0 ? datum.crop : 'Other grains and oilseeds'",
      "as": "group"
    },
    {
      "calculate": "indexof(['Wheat','Barley','Canola','Other grains and oilseeds'], datum.group)",
      "as": "ord"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "production_kt",
          "as": "kt"
        }
      ],
      "groupby": [
        "year",
        "group",
        "ord"
      ]
    },
    {
      "stack": "kt",
      "groupby": [
        "year"
      ],
      "sort": [
        {
          "field": "ord",
          "order": "ascending"
        }
      ],
      "offset": "center",
      "as": [
        "lo",
        "hi"
      ]
    },
    {
      "calculate": "(datum.lo + datum.hi) / 2",
      "as": "mid"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "pick",
          "select": {
            "type": "point",
            "fields": [
              "group"
            ],
            "on": "click[item() && item().mark && item().mark.marktype === 'area']",
            "clear": "dblclick"
          }
        }
      ],
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1960.5,
              2024.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "values": [
              1961,
              1970,
              1980,
              1990,
              2000,
              2010,
              2020,
              2024
            ]
          }
        },
        "y": {
          "field": "lo",
          "type": "quantitative",
          "axis": null,
          "title": null
        },
        "y2": {
          "field": "hi"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Wheat",
              "Barley",
              "Canola",
              "Other grains and oilseeds"
            ],
            "range": [
              "#0f3f39",
              "#3e9588",
              "#7461a8",
              "#c3cac5"
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "pick",
            "empty": true,
            "value": 1
          },
          "value": 0.18
        },
        "order": {
          "field": "ord",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "group",
            "type": "nominal",
            "title": "Crop"
          },
          {
            "field": "kt",
            "type": "quantitative",
            "title": "Thousand tonnes harvested",
            "format": ",.0f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024 && datum.group !== 'Other grains and oilseeds'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "align": "left",
        "dx": 8,
        "dy": -11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1960.5,
              2024.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "values": [
              1961,
              1970,
              1980,
              1990,
              2000,
              2010,
              2020,
              2024
            ]
          }
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "group",
          "type": "nominal"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Wheat",
              "Barley",
              "Canola",
              "Other grains and oilseeds"
            ],
            "range": [
              "#0f3f39",
              "#17554c",
              "#5a4a8a",
              "#57625b"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2024 && datum.group !== 'Other grains and oilseeds'"
        },
        {
          "calculate": "format(datum.kt / 1000, '.1f') + ' Mt'",
          "as": "mt"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 15,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "left",
        "dx": 8,
        "dy": 11
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1960.5,
              2024.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "values": [
              1961,
              1970,
              1980,
              1990,
              2000,
              2010,
              2020,
              2024
            ]
          }
        },
        "y": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "mt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 1997 && datum.group === 'Other grains and oilseeds'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "fill": "#5a4a8a",
        "align": "right",
        "dx": -4,
        "dy": -37
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1960.5,
              2024.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "values": [
              1961,
              1970,
              1980,
              1990,
              2000,
              2010,
              2020,
              2024
            ]
          }
        },
        "y": {
          "field": "hi",
          "type": "quantitative"
        },
        "text": {
          "value": "1990s: canola takes off"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 1997 && datum.group === 'Other grains and oilseeds'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "right",
        "dx": -4,
        "dy": -14
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              1960.5,
              2024.5
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "format": "d",
            "grid": false,
            "values": [
              1961,
              1970,
              1980,
              1990,
              2000,
              2010,
              2020,
              2024
            ]
          }
        },
        "y": {
          "field": "hi",
          "type": "quantitative"
        },
        "text": {
          "value": "0.03 Mt in 1970, 6.4 Mt by 2024"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 2002,
            "label": "2002 and 2006 droughts",
            "sub": "each halved the wheat crop",
            "side": -1
          },
          {
            "year": 2022,
            "label": "2022 record",
            "sub": "41.2 Mt of wheat",
            "side": -1
          }
        ]
      },
      "layer": [
        {
          "mark": {
            "type": "rule",
            "stroke": "#7a857e",
            "strokeWidth": 1,
            "strokeDash": [
              2,
              3
            ],
            "opacity": 0.8
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side < 0"
            }
          ],
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 16,
            "fontWeight": 600,
            "fill": "#161f1b",
            "align": "right",
            "dx": -8,
            "dy": -212,
            "limit": 190
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "text": {
              "field": "label",
              "type": "nominal"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.side < 0"
            }
          ],
          "mark": {
            "type": "text",
            "font": "'Source Sans 3', 'Segoe UI', sans-serif",
            "fontSize": 16,
            "fontWeight": 400,
            "fill": "#57625b",
            "align": "right",
            "dx": -8,
            "dy": -190,
            "limit": 190
          },
          "encoding": {
            "x": {
              "field": "year",
              "type": "quantitative"
            },
            "text": {
              "field": "sub",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "a": 0,
            "b": 10000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#333e38",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "value": -106
        },
        "y": {
          "field": "a",
          "type": "quantitative"
        },
        "y2": {
          "field": "b"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "m": 5000,
            "t": "10 Mt"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "fill": "#333e38",
        "align": "left",
        "baseline": "bottom",
        "x": -98,
        "dy": -3
      },
      "encoding": {
        "y": {
          "field": "m",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "m": 5000,
            "t": "of harvest"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 15,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "left",
        "baseline": "top",
        "x": -98,
        "dy": 3
      },
      "encoding": {
        "y": {
          "field": "m",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 78"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 78"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
