{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 200,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      0
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "A third of daily energy still comes from discretionary food",
    "subtitle": "Share of daily energy from foods such as confectionery, soft drink, pastries and alcohol, in two national surveys.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 22,
    "bottom": 0
  },
  "data": {
    "url": "data/food_consumption_indicators.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.indicator === 'Energy from discretionary foods'"
    },
    {
      "calculate": "replace(datum.year, '-', '–')",
      "as": "survey"
    },
    {
      "calculate": "100 - datum.value",
      "as": "core"
    },
    {
      "fold": [
        "value",
        "core"
      ],
      "as": [
        "part",
        "pct"
      ]
    },
    {
      "calculate": "datum.part === 'value' ? 'Discretionary food' : 'Everything else'",
      "as": "kind"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "survey",
          "type": "nominal",
          "title": null,
          "sort": [
            "2011–12",
            "2023"
          ],
          "scale": {
            "paddingInner": 0.45,
            "paddingOuter": 0.3
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "x": {
          "field": "pct",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "stack": "zero",
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "format": "d",
            "labelExpr": "datum.value + '%'",
            "grid": false,
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "kind",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Discretionary food",
              "Everything else"
            ],
            "range": [
              "#9c6114",
              "#dee2dd"
            ]
          }
        },
        "order": {
          "field": "part",
          "sort": "descending"
        },
        "tooltip": [
          {
            "field": "survey",
            "type": "nominal",
            "title": "Survey"
          },
          {
            "field": "kind",
            "type": "nominal",
            "title": "Food"
          },
          {
            "field": "pct",
            "type": "quantitative",
            "title": "Share of daily energy (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.part === 'value'"
        },
        {
          "calculate": "format(datum.pct, '.1f') + '% of daily energy'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "fill": "#84520f",
        "align": "left",
        "baseline": "bottom",
        "dy": -26
      },
      "encoding": {
        "y": {
          "field": "survey",
          "type": "nominal",
          "title": null,
          "sort": [
            "2011–12",
            "2023"
          ],
          "scale": {
            "paddingInner": 0.45,
            "paddingOuter": 0.3
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "x": {
          "datum": 0,
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Dietary guidelines: these foods are for"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#333e38",
        "x": 0,
        "y": {
          "expr": "(height + 42) + 0"
        },
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "“only sometimes and in small amounts”"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#333e38",
        "x": 0,
        "y": {
          "expr": "(height + 42) + 20"
        },
        "align": "left",
        "baseline": "top"
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
