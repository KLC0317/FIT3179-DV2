{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 370,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#57625b",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": true,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#333e38",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#57625b",
      "symbolStrokeWidth": 0,
      "offset": 6,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Inter",
      "fontSize": 12
    },
    "title": {
      "font": "Noto Serif",
      "fontSize": 14,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 16
    }
  },
  "title": {
    "text": "When the rain stops, the water still has to come from somewhere",
    "subtitle": "Each point is one financial year; the path runs 2014-15 to 2023-24. The driest year is highlighted.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 5,
    "top": 5,
    "bottom": 5,
    "right": 30
  },
  "data": {
    "url": "data/water_account_national.csv",
    "format": {
      "type": "csv",
      "parse": {
        "area_average_rainfall_mm": "number",
        "total_water_consumption_GL": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.8,
        "color": "#c3cac5",
        "interpolate": "catmull-rom"
      },
      "encoding": {
        "x": {
          "field": "area_average_rainfall_mm",
          "type": "quantitative",
          "title": "Area-average rainfall (mm)",
          "scale": {
            "domain": [
              320,
              650
            ],
            "nice": false
          },
          "axis": {
            "values": [
              350,
              400,
              450,
              500,
              550,
              600
            ],
            "grid": true
          }
        },
        "y": {
          "field": "total_water_consumption_GL",
          "type": "quantitative",
          "title": "Total water consumed (gigalitres)",
          "scale": {
            "domain": [
              11500,
              18000
            ],
            "nice": false
          },
          "axis": {
            "format": ",.0f",
            "values": [
              12000,
              14000,
              16000,
              18000
            ],
            "grid": true
          }
        },
        "order": {
          "field": "year",
          "type": "ordinal"
        }
      }
    },
    {
      "transform": [
        {
          "calculate": "datum.year === '2019-20' ? 'focus' : 'rest'",
          "as": "emph"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 1,
        "stroke": "#fbfaf6",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "area_average_rainfall_mm",
          "type": "quantitative",
          "title": "Area-average rainfall (mm)",
          "scale": {
            "domain": [
              320,
              650
            ],
            "nice": false
          },
          "axis": {
            "values": [
              350,
              400,
              450,
              500,
              550,
              600
            ],
            "grid": true
          }
        },
        "y": {
          "field": "total_water_consumption_GL",
          "type": "quantitative",
          "title": "Total water consumed (gigalitres)",
          "scale": {
            "domain": [
              11500,
              18000
            ],
            "nice": false
          },
          "axis": {
            "format": ",.0f",
            "values": [
              12000,
              14000,
              16000,
              18000
            ],
            "grid": true
          }
        },
        "size": {
          "condition": {
            "test": "datum.emph === 'focus'",
            "value": 280
          },
          "value": 120
        },
        "color": {
          "field": "emph",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "focus",
              "rest"
            ],
            "range": [
              "#9c6114",
              "#7a857e"
            ]
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "area_average_rainfall_mm",
            "type": "quantitative",
            "title": "Rainfall (mm)"
          },
          {
            "field": "total_water_consumption_GL",
            "type": "quantitative",
            "title": "Water consumed (GL)",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['2014-15','2023-24'], datum.year) >= 0"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "fill": "#161f1b",
        "align": "left",
        "dx": 13,
        "dy": -7
      },
      "encoding": {
        "x": {
          "field": "area_average_rainfall_mm",
          "type": "quantitative",
          "title": "Area-average rainfall (mm)",
          "scale": {
            "domain": [
              320,
              650
            ],
            "nice": false
          },
          "axis": {
            "values": [
              350,
              400,
              450,
              500,
              550,
              600
            ],
            "grid": true
          }
        },
        "y": {
          "field": "total_water_consumption_GL",
          "type": "quantitative",
          "title": "Total water consumed (gigalitres)",
          "scale": {
            "domain": [
              11500,
              18000
            ],
            "nice": false
          },
          "axis": {
            "format": ",.0f",
            "values": [
              12000,
              14000,
              16000,
              18000
            ],
            "grid": true
          }
        },
        "text": {
          "field": "year",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "indexof(['2014-15','2023-24'], datum.year) >= 0"
        },
        {
          "calculate": "datum.year === '2014-15' ? 'path starts here' : 'path ends here'",
          "as": "role"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "left",
        "dx": 13,
        "dy": 8
      },
      "encoding": {
        "x": {
          "field": "area_average_rainfall_mm",
          "type": "quantitative",
          "title": "Area-average rainfall (mm)",
          "scale": {
            "domain": [
              320,
              650
            ],
            "nice": false
          },
          "axis": {
            "values": [
              350,
              400,
              450,
              500,
              550,
              600
            ],
            "grid": true
          }
        },
        "y": {
          "field": "total_water_consumption_GL",
          "type": "quantitative",
          "title": "Total water consumed (gigalitres)",
          "scale": {
            "domain": [
              11500,
              18000
            ],
            "nice": false
          },
          "axis": {
            "format": ",.0f",
            "values": [
              12000,
              14000,
              16000,
              18000
            ],
            "grid": true
          }
        },
        "text": {
          "field": "role",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 347,
            "y": 12148,
            "t": "2019-20: equal-driest year, lowest water use"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 400,
        "fill": "#84520f",
        "align": "left",
        "dx": 15,
        "dy": 6,
        "limit": 330
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
