{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 300,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      160
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "South Australia's harvest more than halved in two seasons",
    "subtitle": "Wheat sold by each state, 2022–23 against 2024–25. Choose a state to highlight it.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 0,
    "bottom": 0
  },
  "params": [
    {
      "name": "state",
      "value": "South Australia",
      "bind": {
        "input": "select",
        "options": [
          "South Australia",
          "New South Wales",
          "Victoria",
          "Queensland",
          "Western Australia"
        ],
        "name": "Highlight  "
      }
    }
  ],
  "data": {
    "url": "data/wheat_state_density.csv",
    "format": {
      "type": "csv",
      "parse": {
        "kt_2022_23": "number",
        "kt_2023_24": "number",
        "kt_2024_25": "number",
        "tpk_2022_23": "number",
        "tpk_2023_24": "number",
        "tpk_2024_25": "number",
        "area_km2": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.kt_2022_23) && isValid(datum.kt_2024_25) && datum.kt_2022_23 > 100"
    },
    {
      "calculate": "datum.kt_2024_25 / datum.kt_2022_23 - 1",
      "as": "change"
    },
    {
      "fold": [
        "kt_2022_23",
        "kt_2024_25"
      ],
      "as": [
        "season",
        "kt"
      ]
    },
    {
      "calculate": "datum.season === 'kt_2022_23' ? '2022–23' : '2024–25'",
      "as": "label"
    },
    {
      "calculate": "datum.state === state ? 'focus' : 'rest'",
      "as": "emph"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.4,
        "point": {
          "filled": true,
          "size": 62
        }
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.34
          },
          "axis": {
            "labelFontSize": 16,
            "labelFontWeight": 700,
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#161f1b"
          }
        },
        "y": {
          "field": "kt",
          "type": "quantitative",
          "axis": {
            "title": "Thousand tonnes",
            "titleAngle": 0,
            "titleAlign": "left",
            "titleBaseline": "bottom",
            "titleX": -108,
            "titleY": -12,
            "titleFontWeight": 600,
            "titleColor": "#333e38",
            "grid": true,
            "format": ",.0f"
          }
        },
        "detail": {
          "field": "state",
          "type": "nominal"
        },
        "color": {
          "field": "emph",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "focus",
              "rest"
            ],
            "range": [
              "#9c6114",
              "#a0a9a3"
            ]
          }
        },
        "order": {
          "field": "emph",
          "type": "nominal",
          "sort": "descending"
        },
        "strokeWidth": {
          "condition": {
            "test": "datum.emph === 'focus'",
            "value": 3.2
          },
          "value": 2
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "label",
            "type": "nominal",
            "title": "Season"
          },
          {
            "field": "kt",
            "type": "quantitative",
            "title": "Wheat sold (thousand tonnes)",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label === '2024–25' && datum.kt > 900 && indexof(['New South Wales','South Australia'], datum.state) >= 0"
        },
        {
          "calculate": "datum.state + '  ' + format(datum.kt, ',.0f')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 600,
        "align": "left",
        "dx": 11,
        "dy": -9
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.34
          },
          "axis": {
            "labelFontSize": 16,
            "labelFontWeight": 700,
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#161f1b"
          }
        },
        "y": {
          "field": "kt",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        },
        "color": {
          "field": "emph",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "focus",
              "rest"
            ],
            "range": [
              "#84520f",
              "#333e38"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label === '2024–25' && datum.kt > 900 && indexof(['Western Australia','Queensland'], datum.state) >= 0"
        },
        {
          "calculate": "datum.state + '  ' + format(datum.kt, ',.0f')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 600,
        "align": "left",
        "dx": 11,
        "dy": 10
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.34
          },
          "axis": {
            "labelFontSize": 16,
            "labelFontWeight": 700,
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#161f1b"
          }
        },
        "y": {
          "field": "kt",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        },
        "color": {
          "field": "emph",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "focus",
              "rest"
            ],
            "range": [
              "#84520f",
              "#333e38"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.label === '2024–25' && datum.kt > 900 && indexof(['Victoria'], datum.state) >= 0"
        },
        {
          "calculate": "datum.state + '  ' + format(datum.kt, ',.0f')",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 600,
        "align": "left",
        "dx": 11,
        "dy": -5
      },
      "encoding": {
        "x": {
          "field": "label",
          "type": "ordinal",
          "title": null,
          "scale": {
            "padding": 0.34
          },
          "axis": {
            "labelFontSize": 16,
            "labelFontWeight": 700,
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelAngle": 0,
            "labelPadding": 8,
            "labelColor": "#161f1b"
          }
        },
        "y": {
          "field": "kt",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        },
        "color": {
          "field": "emph",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "focus",
              "rest"
            ],
            "range": [
              "#84520f",
              "#333e38"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state === state && datum.label === '2024–25'"
        },
        {
          "calculate": "datum.state + ': ' + (datum.change < 0 ? 'down ' : 'up ') + format(abs(datum.change), '.0%')",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "fill": "#84520f",
        "align": "right",
        "baseline": "bottom",
        "x": {
          "expr": "width"
        },
        "y": -34
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "2024: record-low rain on its grain belt"
          }
        ]
      },
      "transform": [
        {
          "filter": "state === 'South Australia'"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#333e38",
        "align": "right",
        "baseline": "bottom",
        "x": {
          "expr": "width"
        },
        "y": -12
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
