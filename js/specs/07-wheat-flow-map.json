{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 570,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      0,
      0
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Most of the wheat goes to Asia, and the biggest buyer is Indonesia",
    "subtitle": "Great-circle routes to Australia's twelve largest wheat markets in 2024. Arrows point to the buyer; line width is tonnes. Hover over a route to isolate it.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 5,
    "bottom": 5
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -99,
      0
    ],
    "scale": {
      "expr": "min(width / 3.15, height / 1.62)"
    },
    "translate": {
      "expr": "[width * 0.5, height * 0.49]"
    }
  },
  "layer": [
    {
      "data": {
        "url": "data/world_ne_110m.topojson",
        "format": {
          "type": "topojson",
          "feature": "oceans"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d6e3e9",
        "stroke": null,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/world_ne_110m.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_graticules_30"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#c3d3da",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/world_ne_110m.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e7e6de",
        "stroke": "#fefdf9",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/world_ne_110m.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "data/wheat_export_flows.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "dest_lon": "number",
                  "dest_lat": "number",
                  "quantity_kt": "number",
                  "share_pct": "number"
                }
              }
            },
            "key": "destination",
            "fields": [
              "quantity_kt"
            ]
          }
        },
        {
          "filter": "isValid(datum.quantity_kt)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#ddeeea",
        "stroke": "#fefdf9",
        "strokeWidth": 0.5,
        "clip": true
      }
    },
    {
      "data": {
        "url": "data/wheat_export_arcs.csv",
        "format": {
          "type": "csv",
          "parse": {
            "step": "number",
            "longitude": "number",
            "latitude": "number",
            "quantity_kt": "number",
            "share_pct": "number"
          }
        }
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "destination"
            ],
            "on": "mouseover[item() && item().mark && item().mark.marktype === 'line']",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear",
        "strokeCap": "round",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "detail": {
          "field": "destination",
          "type": "nominal"
        },
        "strokeWidth": {
          "field": "quantity_kt",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "sqrt",
            "range": [
              1.2,
              11
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.destination === 'Indonesia'",
            "value": "#9c6114"
          },
          "value": "#0f3f39"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": true,
            "value": 0.62
          },
          "value": 0.08
        },
        "tooltip": [
          {
            "field": "destination",
            "type": "nominal",
            "title": "Destination"
          },
          {
            "field": "quantity_kt",
            "type": "quantitative",
            "title": "Wheat (thousand tonnes)",
            "format": ","
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of wheat exports (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/wheat_export_arcs.csv",
        "format": {
          "type": "csv",
          "parse": {
            "step": "number",
            "longitude": "number",
            "latitude": "number",
            "quantity_kt": "number",
            "share_pct": "number"
          }
        }
      },
      "transform": [
        {
          "window": [
            {
              "op": "lag",
              "field": "longitude",
              "as": "lon0"
            },
            {
              "op": "lag",
              "field": "latitude",
              "as": "lat0"
            }
          ],
          "groupby": [
            "destination"
          ],
          "sort": [
            {
              "field": "step",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.step === 25"
        },
        {
          "calculate": "((datum.lon0 - 104) * PI / 180) * cos(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180))) / (sqrt(3) / 2 * (1.340264 - 3 * 0.081106 * pow(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)), 2) + pow(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)), 6) * (7 * 0.000893 + 9 * 0.003796 * pow(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)), 2))))",
          "as": "x0"
        },
        {
          "calculate": "asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)) * (1.340264 - 0.081106 * pow(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)), 2) + pow(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)), 6) * (0.000893 + 0.003796 * pow(asin(sqrt(3) / 2 * sin(datum.lat0 * PI / 180)), 2)))",
          "as": "y0"
        },
        {
          "calculate": "((datum.longitude - 104) * PI / 180) * cos(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180))) / (sqrt(3) / 2 * (1.340264 - 3 * 0.081106 * pow(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)), 2) + pow(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)), 6) * (7 * 0.000893 + 9 * 0.003796 * pow(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)), 2))))",
          "as": "x1"
        },
        {
          "calculate": "asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)) * (1.340264 - 0.081106 * pow(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)), 2) + pow(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)), 6) * (0.000893 + 0.003796 * pow(asin(sqrt(3) / 2 * sin(datum.latitude * PI / 180)), 2)))",
          "as": "y1"
        },
        {
          "calculate": "atan2(datum.x1 - datum.x0, datum.y1 - datum.y0) * 180 / PI",
          "as": "bearing"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "triangle-up",
        "filled": true,
        "stroke": "#fefdf9",
        "strokeWidth": 0.8,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "angle": {
          "field": "bearing",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "quantity_kt",
          "type": "quantitative",
          "legend": null,
          "scale": {
            "type": "sqrt",
            "range": [
              45,
              260
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.destination === 'Indonesia'",
            "value": "#9c6114"
          },
          "value": "#0f3f39"
        },
        "opacity": {
