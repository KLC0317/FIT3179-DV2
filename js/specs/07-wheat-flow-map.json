            "field": "quantity_kt",
            "type": "quantitative",
            "title": "Wheat (thousand tonnes)",
            "format": ","
          },
          {
            "field": "share_pct",
            "type": "quantitative",
            "title": "Share of wheat exports (%)",
            "format": ".1f"
          }
        ]
      }
    },
