{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": "Wheat alone is worth almost half the crop",
    "subtitle": "Local value of broadacre crops, 2024–25, grouped by crop type."
  },
  "width": 600,
  "height": 325,
  "padding": {
    "left": 0,
    "right": 0,
    "top": 1,
    "bottom": 0
  },
  "background": null,
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "data": [
    {
      "name": "tree",
      "url": "data/crop_value_hierarchy.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "formula",
          "as": "value",
          "expr": "datum.value_AUD_m === '' ? null : toNumber(datum.value_AUD_m)"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "method": "squarify",
          "round": true,
          "paddingInner": 3,
          "paddingTop": 46,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ]
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "grand"
          ]
        }
      ]
    },
    {
      "name": "group_totals",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "crop_type"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        },
        {
          "type": "lookup",
          "from": "group_totals",
          "key": "crop_type",
          "fields": [
            "name"
          ],
          "values": [
            "total"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "labelled",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "(datum.x1-datum.x0) > 68 && (datum.y1-datum.y0) > 54"
        }
      ]
    },
    {
      "name": "hero",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.name === 'Wheat'"
        }
      ]
    }
  ],
  "scales": [],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "enter": {
          "stroke": {
            "value": "#fefdf9"
          },
          "strokeWidth": {
            "value": 2
          }
        },
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "datum.name === 'Wheat' ? '#0f3f39' : datum.name === 'Barley' ? '#3e9588' : datum.name === 'Canola' ? '#7461a8' : '#c3cac5'"
          },
          "tooltip": {
            "signal": "{'Crop': datum.name, 'Type': datum.crop_type, 'Local value 2024–25': '$' + format(datum.value, ',.0f') + 'm', 'Share of all crops': format(datum.value / datum.grand, '.1%')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "labelled"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 10"
          },
          "y": {
            "signal": "datum.y0 + 23"
          },
          "text": {
            "field": "name"
          },
          "fill": {
            "signal": "indexof(['Wheat','Canola'], datum.name) >= 0 ? '#ffffff' : '#161f1b'"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 700
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 18"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "labelled"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 10"
          },
          "y": {
            "signal": "datum.y0 + 45"
          },
          "text": {
            "signal": "'$' + format(datum.value/1000, '.2f') + 'b'"
          },
          "fill": {
            "signal": "indexof(['Wheat','Canola'], datum.name) >= 0 ? '#ffffff' : '#161f1b'"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 18"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "hero"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 10"
          },
          "y": {
            "signal": "datum.y1 - 14"
          },
          "text": {
            "signal": "format(datum.value / datum.grand, '.0%') + ' of all crop value'"
          },
          "fill": {
            "value": "#ffffff"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 600
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 18"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "transparent"
          },
          "stroke": {
            "value": "#333e38"
          },
          "strokeWidth": {
            "value": 1.5
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 19"
          },
          "text": {
            "signal": "upper(datum.name)"
          },
          "fill": {
            "value": "#333e38"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 700
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 16"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 38"
          },
          "text": {
            "signal": "'$' + format(datum.total/1000, '.2f') + 'b total'"
          },
          "fill": {
            "value": "#57625b"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 400
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 16"
          }
        }
      }
    }
  ]
}
