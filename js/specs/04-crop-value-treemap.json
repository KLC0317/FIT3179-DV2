{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": {
    "text": "Wheat alone is worth almost half the crop",
    "subtitle": "Local value of broadacre crops, 2024–25, grouped by crop type."
  },
  "width": 600,
  "height": 397,
  "padding": {
    "left": 0,
    "right": 0,
    "top": 18,
    "bottom": 0
  },
  "background": null,
  "autosize": {
    "type": "none",
    "contains": "padding"
  },
  "data": [
    {
      "name": "tree",
      "url": "data/crop_value_hierarchy.csv",
      "format": {
        "type": "csv"
      },
      "transform": [
        {
          "type": "formula",
          "as": "value",
          "expr": "datum.value_AUD_m === '' ? null : toNumber(datum.value_AUD_m)"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "method": "squarify",
          "round": true,
          "paddingInner": 4,
          "paddingTop": 30,
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height - 54 + 30"
            }
          ]
        },
        {
          "type": "formula",
          "as": "y0",
          "expr": "datum.y0 - 30"
        },
        {
          "type": "formula",
          "as": "y1",
          "expr": "datum.y1 - 30"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 2"
        },
        {
          "type": "joinaggregate",
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "grand"
          ]
        }
      ]
    },
    {
      "name": "group_totals",
      "source": "leaves",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "crop_type"
          ],
          "fields": [
            "value"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth === 1"
        },
        {
          "type": "formula",
          "as": "type",
          "expr": "slice(datum.name, 0, -1)"
        },
        {
          "type": "lookup",
          "from": "group_totals",
          "key": "crop_type",
          "fields": [
            "type"
          ],
          "values": [
            "total"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "hero",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.name === 'Wheat'"
        }
      ]
    },
    {
      "name": "tall",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.y1 - datum.y0 >= 50"
        }
      ]
    },
    {
      "name": "short",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.y1 - datum.y0 < 50"
        }
      ]
    }
  ],
  "scales": [],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#eaece8"
          },
          "stroke": {
            "value": "#a0a9a3"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 9"
          },
          "y": {
            "signal": "datum.y0 + 20"
          },
          "text": {
            "signal": "upper(datum.name) + '  ' + format(datum.total / 1000, '$.1f') + 'b'"
          },
          "fill": {
            "value": "#333e38"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 700
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          }
        }
      },
      "from": {
        "data": "groups"
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "x2": {
            "field": "x1"
          },
          "y": {
            "field": "y0"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "datum.name === 'Wheat' ? '#0f3f39' : datum.name === 'Barley' ? '#a0a9a3' : datum.name === 'Canola' ? '#7461a8' : '#dee2dd'"
          },
          "cursor": {
            "value": "default"
          },
          "tooltip": {
            "signal": "{'Crop': datum.name, 'Type': datum.crop_type, 'Local value 2024–25': format(datum.value, '$,.0f') + ' million', 'Share of all crops': format(datum.value / datum.grand, '.1%'), 'Made up of': datum.detail ? datum.detail : 'one crop'}"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 21"
          },
          "text": {
            "signal": "datum.name === 'Other pulses' ? 'Others' : datum.name"
          },
          "fill": {
            "signal": "indexof(['Wheat','Canola'], datum.name) >= 0 ? '#ffffff' : '#161f1b'"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 700
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          }
        }
      },
      "from": {
        "data": "tall"
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y0 + 41"
          },
          "text": {
            "signal": "format(datum.value / 1000, '$.1f') + 'b'"
          },
          "fill": {
            "signal": "indexof(['Wheat','Canola'], datum.name) >= 0 ? '#ffffff' : '#161f1b'"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 400
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          }
        }
      },
      "from": {
        "data": "tall"
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "(datum.y0 + datum.y1) / 2"
          },
          "text": {
            "signal": "datum.name === 'Other pulses' ? 'Others' : datum.name + '  ' + format(datum.value / 1000, '$.1f') + 'b'"
          },
          "fill": {
            "signal": "indexof(['Wheat','Canola'], datum.name) >= 0 ? '#ffffff' : '#161f1b'"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 15
          },
          "fontWeight": {
            "value": 700
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          },
          "baseline": {
            "value": "middle"
          }
        }
      },
      "from": {
        "data": "short"
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0 + 8"
          },
          "y": {
            "signal": "datum.y1 - 12"
          },
          "text": {
            "signal": "format(datum.value / datum.grand, '.0%') + ' of all crop value'"
          },
          "fill": {
            "value": "#ffffff"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 600
          },
          "limit": {
            "signal": "datum.x1 - datum.x0 - 14"
          }
        }
      },
      "from": {
        "data": "hero"
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "height - 30"
          },
          "text": {
            "value": "Chickpeas: $0.4b to $1.7b in a year,"
          },
          "fill": {
            "value": "#161f1b"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 700
          },
          "baseline": {
            "value": "bottom"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "signal": "height - 8"
          },
          "text": {
            "value": "after India dropped its import duty in 2024"
          },
          "fill": {
            "value": "#333e38"
          },
          "font": {
            "value": "'Source Sans 3', 'Segoe UI', sans-serif"
          },
          "fontSize": {
            "value": 16
          },
          "fontWeight": {
            "value": 400
          },
          "baseline": {
            "value": "bottom"
          }
        }
      }
    }
  ]
}
