          "axis": {
            "labelFontSize": 15,
            "labelFontWeight": 700,
            "labelColor": "#333e38",
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelPadding": 8,
            "labelAngle": 0,
            "labelLimit": 120,
            "labelLineHeight": 17,
            "labelExpr": "datum.label == 'Water per $' ? ['Water', 'per $'] : split(datum.label, ' ')"
          }
        },
        "y": {
          "field": "norm",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 400,
            "labelColor": "#57625b",
            "labelFontSize": 15,
            "values": [
              0,
              1
            ],
            "labelExpr": "datum.value == 1 ? 'ten-year high' : 'ten-year low'",
            "title": "Each axis: its own ten-year range",
            "titleAngle": 0,
            "titleAlign": "left",
            "titleBaseline": "bottom",
            "titleX": -108,
            "titleY": -12,
            "titleFontWeight": 600,
            "titleColor": "#333e38"
          }
        },
        "color": {
          "condition": {
            "param": "yr",
            "empty": false,
            "value": "#39423d"
