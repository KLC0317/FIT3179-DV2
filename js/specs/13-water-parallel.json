{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 336,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      80
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Household water use drifts down, wet years or dry",
    "subtitle": "One line per year across four measures, each axis from its own ten-year low to high. Hover over a line to follow one year.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/water_account_national.csv",
    "format": {
      "type": "csv",
      "parse": {
        "area_average_rainfall_mm": "number",
        "total_water_consumption_GL": "number",
        "average_household_water_use_kL": "number",
        "industry_water_intensity_ML_per_AUD_m_GVA": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "area_average_rainfall_mm",
        "total_water_consumption_GL",
        "average_household_water_use_kL",
        "industry_water_intensity_ML_per_AUD_m_GVA"
      ],
      "as": [
        "metric",
        "raw"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "raw",
          "as": "lo"
        },
        {
          "op": "max",
          "field": "raw",
          "as": "hi"
        }
      ],
      "groupby": [
        "metric"
      ]
    },
    {
      "calculate": "(datum.raw - datum.lo) / (datum.hi - datum.lo)",
      "as": "norm"
    },
    {
      "calculate": "{'area_average_rainfall_mm':'Rainfall','total_water_consumption_GL':'Water used','average_household_water_use_kL':'Households','industry_water_intensity_ML_per_AUD_m_GVA':'Water per $'}[datum.metric]",
      "as": "axis"
    },
    {
      "calculate": "{'area_average_rainfall_mm':' mm','total_water_consumption_GL':' GL','average_household_water_use_kL':' kL per household','industry_water_intensity_ML_per_AUD_m_GVA':' ML per $m of output'}[datum.metric]",
      "as": "unit"
    },
    {
      "calculate": "format(datum.raw, ',.0f') + datum.unit",
      "as": "value_text"
    },
    {
      "calculate": "replace(datum.year, '-', '–')",
      "as": "yr"
    },
    {
      "calculate": "datum.year === '2019-20' ? 'dry' : datum.year === '2022-23' ? 'wet' : 'rest'",
      "as": "emph"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#d9ded6",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "axis",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Water used",
            "Households",
            "Water per $"
          ],
          "axis": {
            "labelFontSize": 15,
            "labelFontWeight": 700,
            "labelColor": "#333e38",
            "grid": false,
            "domain": false,
            "ticks": false,
            "labelPadding": 8,
            "labelAngle": 0,
            "labelLimit": 120,
            "labelLineHeight": 17,
            "labelExpr": "datum.label == 'Water per $' ? ['Water', 'per $'] : split(datum.label, ' ')"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.emph === 'rest'"
        }
      ],
      "params": [
        {
          "name": "yr",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "on": "mouseover[item() && item().mark && item().mark.marktype === 'line']",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 34
        }
      },
      "encoding": {
        "x": {
          "field": "axis",
          "type": "nominal",
          "title": null,
          "sort": [
            "Rainfall",
            "Water used",
            "Households",
            "Water per $"
