{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 267,
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#57625b",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "Inter",
      "labelFontSize": 12,
      "labelColor": "#333e38",
      "titleFont": "Inter",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#57625b",
      "symbolStrokeWidth": 0,
      "offset": 6,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "Inter",
      "fontSize": 12
    },
    "title": {
      "font": "Noto Serif",
      "fontSize": 14,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 16
    }
  },
  "title": {
    "text": "One in eight households ran short of food",
    "subtitle": "Each icon is one Australian household in a hundred, 2023.",
    "subtitleLimit": 760
  },
  "data": {
    "url": "data/food_insecurity_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "affected": "number",
        "col": "number",
        "row": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "text",
        "baseline": "middle",
        "align": "center",
        "fontSize": 27
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "padding": 0
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null,
          "sort": "descending",
          "scale": {
            "padding": 0
          }
        },
        "text": {
          "value": "\ud83c\udfe0"
        },
        "opacity": {
          "condition": {
            "test": "datum.affected == 1",
            "value": 1
          },
          "value": 0.16
        },
        "tooltip": {
          "value": "13.2% of households experienced food insecurity in 2023"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "13.2%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 24,
        "fontWeight": 700,
        "fill": "#84520f",
        "align": "right",
        "x": {
          "expr": "width"
        },
        "y": 6
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "of households"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "right",
        "x": {
          "expr": "width"
        },
        "y": 28
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ]
}
