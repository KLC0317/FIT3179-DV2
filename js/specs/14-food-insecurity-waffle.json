  "title": {
    "text": "More than one in eight households experienced food insecurity",
    "subtitle": "Each house is one Australian household in a hundred, 2023. Ochre houses experienced food insecurity.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 26,
    "bottom": 5
  },
  "data": {
    "url": "data/food_insecurity_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "affected": "number",
        "cell": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.cell % 10",
      "as": "c"
    },
    {
      "calculate": "floor(datum.cell / 10)",
      "as": "r"
    },
    {
      "calculate": "datum.affected == 1 ? 'Ran short of food' : 'Did not'",
      "as": "status"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "point",
        "shape": "M0,-0.95 L0.95,-0.12 L0.7,-0.12 L0.7,0.95 L0.2,0.95 L0.2,0.38 L-0.2,0.38 L-0.2,0.95 L-0.7,0.95 L-0.7,-0.12 L-0.95,-0.12 Z",
        "filled": true,
        "strokeWidth": 0,
        "opacity": 1,
        "size": 316
      },
      "encoding": {
        "x": {
          "field": "c",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "type": "point",
