          "field": "r",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "type": "point",
            "padding": 0.5,
            "range": [
              0,
              228
            ]
          }
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Ran short of food",
              "Did not"
            ],
