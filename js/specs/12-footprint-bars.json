    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.parent === 'root' && datum.name !== 'Output exported'"
    },
    {
      "calculate": "datum.value / 2.2",
      "as": "multiple"
    },
    {
      "calculate": "datum.name === 'Water used' ? 'Water' : datum.name",
