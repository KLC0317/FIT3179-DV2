{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 290,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      58
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#4a554f",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#4a554f",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Agriculture's footprint is far bigger than its economy",
    "subtitle": "Agriculture's share of six national totals. Natural resources in charcoal; the dashed line is its 2.2% share of the economy.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 21,
    "bottom": 28
  },
  "data": {
    "url": "data/farm_footprint_hierarchy.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.parent === 'root' && datum.name !== 'Output exported'"
    },
    {
      "calculate": "datum.value / 2.2",
      "as": "multiple"
    },
    {
      "calculate": "datum.name === 'Water used' ? 'Water' : datum.name === 'GDP' ? 'Economy' : datum.name",
      "as": "row"
    },
    {
      "calculate": "datum.name === 'GDP' ? 'Agriculture share of Australia’s economic output' : datum.indicator",
      "as": "indicator"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#333e38",
        "strokeWidth": 1.5,
        "strokeDash": [
          4,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 2.2,
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "y": {
          "value": -4
        },
        "y2": {
          "value": {
            "expr": "height"
          }
        }
      }
    },
    {
      "mark": {
        "type": "bar",
        "color": "#eaece8"
      },
      "encoding": {
        "y": {
          "field": "row",
          "type": "nominal",
          "title": null,
          "sort": [
            "Water",
            "Land",
            "Exports",
            "Rural jobs",
            "Jobs",
            "Economy"
          ],
          "scale": {
            "paddingInner": 0.5,
            "paddingOuter": 0.25
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "datum": 100
        }
      }
    },
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "y": {
          "field": "row",
          "type": "nominal",
          "title": null,
          "sort": [
            "Water",
            "Land",
            "Exports",
            "Rural jobs",
            "Jobs",
            "Economy"
          ],
          "scale": {
            "paddingInner": 0.5,
            "paddingOuter": 0.25
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.value + '%'",
            "grid": false,
            "domain": false,
            "ticks": false
          },
          "field": "value"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Natural resources",
              "Economy"
            ],
            "range": [
              "#2e3532",
              "#7a857e"
            ]
          }
        },
        "tooltip": [
          {
            "field": "indicator",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          },
          {
            "field": "multiple",
            "type": "quantitative",
            "title": "Times its share of the economy",
            "format": ".1f"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Period"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.value, '.1f') + '%'",
          "as": "t"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "align": "left",
        "dx": 8
      },
      "encoding": {
        "y": {
          "field": "row",
          "type": "nominal",
          "title": null,
          "sort": [
            "Water",
            "Land",
            "Exports",
            "Rural jobs",
            "Jobs",
            "Economy"
          ],
          "scale": {
            "paddingInner": 0.5,
            "paddingOuter": 0.25
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "datum": 100,
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Natural resources",
              "Economy"
            ],
            "range": [
              "#2e3532",
              "#333e38"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "row": "Water",
            "t": "mostly irrigation"
          },
          {
            "row": "Land",
            "t": "mostly grazing on native vegetation"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 15,
        "fontWeight": 400,
        "fill": "#333e38",
        "align": "left",
        "dx": 6,
        "dy": 24
      },
      "encoding": {
        "y": {
          "field": "row",
          "type": "nominal",
          "title": null,
          "sort": [
            "Water",
            "Land",
            "Exports",
            "Rural jobs",
            "Jobs",
            "Economy"
          ],
          "scale": {
            "paddingInner": 0.5,
            "paddingOuter": 0.25
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "datum": 2.2,
          "type": "quantitative"
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 58"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 58"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
