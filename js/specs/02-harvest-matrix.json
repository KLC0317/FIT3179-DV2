{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 236,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      78
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Droughts cut through the winter crops all at once",
    "subtitle": "Each cell is one crop in one year against its own eleven-year normal. Ochre is a short year, teal a surplus.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/crop_production_long.csv",
    "format": {
      "type": "csv",
      "parse": {
        "production_kt": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "median",
          "field": "production_kt",
          "as": "baseline"
        }
      ],
      "frame": [
        -5,
        5
      ],
      "groupby": [
        "crop"
      ],
      "sort": [
        {
          "field": "year",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.baseline > 0 && datum.production_kt > 0"
    },
    {
      "calculate": "100 * (datum.production_kt / datum.baseline - 1)",
      "as": "dev"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "axis": {
            "values": [
              1961,
              1970,
              1980,
              1990,
              2000,
              2010,
              2020,
              2024
            ],
            "labelAngle": 0,
            "grid": false,
            "ticks": false,
            "domain": false
          }
        },
        "y": {
          "field": "crop",
          "type": "nominal",
          "title": null,
          "sort": [
            "Wheat",
            "Barley",
            "Canola",
            "Sugar cane",
            "Maize",
            "Dry peas",
            "Soybeans"
          ],
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#333e38",
            "labelFontSize": 16
          }
        },
        "color": {
          "field": "dev",
          "type": "quantitative",
          "title": "Harvest against its eleven-year normal (%)",
          "scale": {
            "type": "threshold",
            "domain": [
              -40,
              -15,
              15,
              40
            ],
            "range": [
              "#84520f",
              "#d6a248",
              "#efeee7",
              "#5ba79b",
              "#0f3f39"
            ]
          },
          "legend": {
            "direction": "horizontal",
            "orient": "none",
            "legendX": -108,
            "legendY": -92,
            "symbolType": "square",
            "symbolSize": 170,
            "format": "+d",
            "titleLimit": 360
          }
        },
        "tooltip": [
          {
            "field": "crop",
            "type": "nominal",
            "title": "Crop"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "production_kt",
            "type": "quantitative",
            "title": "Thousand tonnes harvested",
            "format": ",.0f"
          },
          {
            "field": "baseline",
            "type": "quantitative",
            "title": "Eleven-year normal",
            "format": ",.0f"
          },
          {
            "field": "dev",
            "type": "quantitative",
            "title": "vs normal (%)",
            "format": "+.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1982
          },
          {
            "year": 1994
          },
          {
            "year": 2002
          },
          {
            "year": 2006
          },
          {
            "year": 2019
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "triangle-down",
        "filled": true,
        "size": 46,
        "color": "#9c6114",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "value": -7
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "year": 1982
          },
          {
            "year": 1994
          },
          {
            "year": 2002
          },
          {
            "year": 2006
          },
          {
            "year": 2019
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 15,
        "fontWeight": 700,
        "fill": "#84520f",
        "align": "center",
        "baseline": "bottom"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "value": -14
        },
        "text": {
          "field": "year",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "Drought years:"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 15,
        "fontWeight": 600,
        "fill": "#57625b",
        "align": "left",
        "baseline": "bottom",
        "x": -108,
        "y": -14
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 78"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 78"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ]
}
