{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 520,
  "height": 250,
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "usermeta": {
    "gutter": [
      108,
      78
    ]
  },
  "config": {
    "background": null,
    "font": "'Source Sans 3', 'Segoe UI', sans-serif",
    "axis": {
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#57625b",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "titlePadding": 10,
      "domainColor": "#d9ded6",
      "tickColor": "#d9ded6",
      "tickSize": 4,
      "grid": false,
      "gridColor": "#eaece8",
      "gridWidth": 1,
      "labelPadding": 6
    },
    "legend": {
      "orient": "top",
      "direction": "horizontal",
      "titleAnchor": "start",
      "labelFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "labelFontSize": 15,
      "labelColor": "#333e38",
      "titleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "titleFontSize": 15,
      "titleFontWeight": 600,
      "titleColor": "#333e38",
      "symbolStrokeWidth": 0,
      "offset": 8,
      "titlePadding": 6,
      "labelLimit": 240,
      "rowPadding": 4
    },
    "view": {
      "stroke": null
    },
    "text": {
      "font": "'Source Sans 3', 'Segoe UI', sans-serif",
      "fontSize": 16
    },
    "title": {
      "font": "Fraunces, Georgia, serif",
      "fontSize": 15,
      "anchor": "start",
      "color": "#161f1b",
      "fontWeight": 600,
      "dy": -6,
      "subtitleFont": "'Source Sans 3', 'Segoe UI', sans-serif",
      "subtitleFontSize": 16,
      "subtitleColor": "#57625b",
      "subtitlePadding": 4,
      "subtitleLineHeight": 17
    }
  },
  "title": {
    "text": "Agriculture's footprint is far bigger than its share of the economy",
    "subtitle": "Each dumbbell runs from agriculture's 2.2% share of GDP to its share of another national total. Natural resources in teal.",
    "subtitleLimit": 760
  },
  "padding": {
    "left": 0,
    "right": 0,
    "top": 5,
    "bottom": 5
  },
  "data": {
    "url": "data/farm_footprint_hierarchy.csv",
    "format": {
      "type": "csv",
      "parse": {
        "value": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.parent === 'root' && datum.name !== 'GDP' && datum.name !== 'Output exported'"
    },
    {
      "calculate": "2.2",
      "as": "ref"
    },
    {
      "calculate": "datum.value / 2.2",
      "as": "multiple"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "stroke": "#a0a9a3",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ]
      },
      "encoding": {
        "x": {
          "datum": 2.2,
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "opacity": 0.45
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "field": "ref",
          "type": "quantitative",
          "title": "Share of the national total (%)",
          "scale": {
            "domain": [
              0,
              76
            ]
          },
          "axis": {
            "grid": true,
            "values": [
              0,
              20,
              40,
              60
            ]
          }
        },
        "x2": {
          "field": "value"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Natural resources",
              "Economy"
            ],
            "range": [
              "#0f3f39",
              "#a0a9a3"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 110,
        "color": "#a0a9a3",
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "field": "ref",
          "type": "quantitative",
          "title": "Share of the national total (%)",
          "scale": {
            "domain": [
              0,
              76
            ]
          },
          "axis": {
            "grid": true,
            "values": [
              0,
              20,
              40,
              60
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 210,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Natural resources",
              "Economy"
            ],
            "range": [
              "#0f3f39",
              "#a0a9a3"
            ]
          }
        },
        "tooltip": [
          {
            "field": "indicator",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "value",
            "type": "quantitative",
            "title": "Share (%)",
            "format": ".1f"
          },
          {
            "field": "multiple",
            "type": "quantitative",
            "title": "Times its GDP share",
            "format": ".1f"
          },
          {
            "field": "period",
            "type": "nominal",
            "title": "Period"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "calculate": "format(datum.value, '.1f') + '%  (' + format(datum.multiple, '.0f') + '\\u00d7)'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 700,
        "align": "left",
        "dx": 14
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "axis": {
            "ticks": false,
            "domain": false,
            "labelAlign": "left",
            "labelPadding": 108,
            "labelLimit": 102,
            "labelFontWeight": 600,
            "labelColor": "#161f1b",
            "labelFontSize": 16
          }
        },
        "x": {
          "field": "value",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "Natural resources",
              "Economy"
            ],
            "range": [
              "#0f3f39",
              "#333e38"
            ]
          }
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "t": "agriculture's 2.2% of GDP"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "'Source Sans 3', 'Segoe UI', sans-serif",
        "fontSize": 16,
        "fontWeight": 400,
        "fill": "#57625b",
        "align": "left",
        "x": {
          "expr": "scale('x', 2.2) + 8"
        },
        "y": 10,
        "limit": 210
      },
      "encoding": {
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": -108
        },
        "x2": {
          "value": -108
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    },
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "value": {
            "expr": "width + 78"
          }
        },
        "x2": {
          "value": {
            "expr": "width + 78"
          }
        },
        "y": {
          "value": 0
        },
        "y2": {
          "value": 1
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "color": "independent"
    }
  }
}
